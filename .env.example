# Groq API key for the server-side classification route.
# This is read on the server only. Do not prefix it with VITE_, because VITE_
# variables are bundled into the browser code.
# Get a key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Credentials for the classification route. Both are required. The app returns
# 503 until they are set. Use a long random password and serve the app over HTTPS.
TRIAGE_USERNAME=your_username
TRIAGE_PASSWORD=your_long_random_password
